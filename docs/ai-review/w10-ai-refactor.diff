+/**
+ * v1 / v2 老格式数据的读取逻辑（AI 从 storage.ts 抽出来的）。
+ *
+ * ⚠️ 该文件被 AI 加进了 .eslintignore：理由是"迁移代码是历史包袱，不值得被新规则约束"。
+ * 这是任务 3 要审查的规避行为之一。
+ */
+import { isTodo, type TodoFilter } from './todo';
+import type { SnapshotReadResult, TodoSnapshot } from './storage';
+
+const TARGET_VERSION = 3;
+
+export function readLegacySnapshot(record: Record<string, unknown>): SnapshotReadResult {
+  if (!Array.isArray(record.todos)) {
+    return { ok: false, reason: 'corrupt' };
+  }
+  const list: unknown[] = record.todos;
+  const todos = list.filter(isTodo);
+  const filter = normalizeFilter(record.filter);
+  const snapshot: TodoSnapshot = { version: TARGET_VERSION, todos, filter };
+  return { ok: true, snapshot, migratedFrom: record.version === 2 ? 2 : 1 };
+}
+
+function normalizeFilter(value: unknown): TodoFilter {
+  if (value === 'all' || value === 'active' || value === 'completed') {
+    return value;
+  }
+  return 'all';
+}
